# Rita's private environment. Copy to ~/.config/adventures-openbq-v6/rita.env,
# chmod 600, outside every repository. Never commit the filled copy.
# OPENAI_BASE_URL: OpenAI-compatible model endpoint, e.g. https://llm.<your-tailnet>.ts.net/v1
OPENAI_BASE_URL=
# OPENAI_API_KEY: the Spark deployment accepts a non-secret placeholder; elsewhere use a real key.
OPENAI_API_KEY=
# DEFAULT_MODEL: e.g. openai:qwen3.6-35b
DEFAULT_MODEL=
# PORT: 7777
PORT=
# COMPANION_TOOLS_ENABLED: false (read only by Rita's companion mcp-server, which the image does not include)
COMPANION_TOOLS_ENABLED=
