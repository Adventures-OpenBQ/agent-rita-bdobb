--- a/src/widgets/parse.ts
+++ b/src/widgets/parse.ts
@@ -1,5 +1,6 @@
 import type { ImagePart, FilePart } from "ai";
 import * as XLSX from "xlsx";
+import { extractText, getDocumentProxy } from "unpdf";
 import type { Widget, ToolMessage } from "../protocol/types";
 import { getLogger } from "../lib/logger";
 
@@ -68,6 +69,12 @@ export interface WidgetItem {
 const classifyItem = _classifyItem;
 const imageMediaType = _imageMediaType;
 
+/** A PDF's text, for model servers that take no `file` part (the Spark's vLLM answers 400). */
+async function pdfText(bytes: Uint8Array): Promise<string> {
+  const { text } = await extractText(await getDocumentProxy(bytes), { mergePages: true });
+  return text;
+}
+
 /**
  * Test-only export. Inline minimal CSV → JSON converter. Note: does NOT
  * handle escaped double-quotes (`""` inside a quoted field) — the bare
@@ -180,12 +187,11 @@ export async function extractWidgetItems(
             logger.warn("PDF too large, skipping", { approxMb: Math.round(approxBytes / 1024 / 1024) });
           } else {
             logger.debug("Inline PDF", { filename: dataFormat?.filename ?? "unknown" });
-            mediaParts.push({
-              type: "file",
-              data: raw.content,
-              mediaType: "application/pdf",
-              filename: dataFormat?.filename,
-            });
+            try {
+              contentParts.push(await pdfText(Uint8Array.from(Buffer.from(raw.content, "base64"))));
+            } catch (e) {
+              logger.error("Failed to parse inline PDF", { error: e });
+            }
           }
         } else if (kind === "xlsx") {
           try {
@@ -215,13 +221,7 @@ export async function extractWidgetItems(
               if (buf.byteLength > MAX_PDF_BYTES) {
                 logger.warn("Fetched PDF too large, skipping", { sizeMb: Math.round(buf.byteLength / 1024 / 1024) });
               } else {
-                const b64 = Buffer.from(buf).toString("base64");
-                mediaParts.push({
-                  type: "file",
-                  data: b64,
-                  mediaType: "application/pdf",
-                  filename: dataFormat?.filename ?? url.split("/").pop(),
-                });
+                contentParts.push(await pdfText(new Uint8Array(buf)));
               }
             }
           } catch (e) {
diff --git a/tests/integration/agent-loop/file-widget.test.ts b/tests/integration/agent-loop/file-widget.test.ts
