-    // "%PDF" header in base64 (`JVBERi0=`).
+/**
+ * A one-page PDF for tests that need a real document: Helvetica 12 pt, 16 pt
+ * leading, the first line's baseline at y = 704 on a US Letter page. Verified to
+ * parse in pdfplumber 0.11.10 and unpdf 1.6.2 (2026-10-28).
+ */
+function pdfBase64(lines: string[]): string {
+  const esc = (s: string) => s.replace(/[\\()]/g, (c) => `\\${c}`);
+  const stream = `BT /F1 12 Tf 72 720 Td 16 TL ${lines.map((l) => `(${esc(l)}) '`).join(" ")} ET`;
+  const objects = [
+    "<< /Type /Catalog /Pages 2 0 R >>",
+    "<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+    "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>",
+    `<< /Length ${stream.length} >>\nstream\n${stream}\nendstream`,
+    "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
+  ];
+  let out = "%PDF-1.4\n";
+  const offsets = objects.map((body, i) => {
+    const at = out.length;
+    out += `${i + 1} 0 obj\n${body}\nendobj\n`;
+    return at;
+  });
+  const xref = out.length;
+  out += `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n${offsets.map((o) => `${String(o).padStart(10, "0")} 00000 n \n`).join("")}`;
+  out += `trailer\n<< /Size ${objects.length + 1} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF\n`;
+  return btoa(out);
+}
+
+describe("file widget — PDF inline content reaches the LLM as text", () => {
+  it("regression: prior tool message with pdf base64 → the PDF's text in user content, no file part", async () => {
     const priorTool: ToolMessage = {
       role: "tool",
       function: "get_widget_data",
@@ -109,7 +135,7 @@ describe("file widget — PDF inline content reaches the LLM as FilePart", () =>
         {
           items: [
             {
-              content: "JVBERi0xLjQK",
+              content: pdfBase64(["Report page one: revenue grew 12 percent."]),
               data_format: { data_type: "pdf", filename: "report.pdf" },
             },
           ],
@@ -134,11 +160,13 @@ describe("file widget — PDF inline content reaches the LLM as FilePart", () =>
       }),
     );
     const parts = findUserPartsMessage(spy.calls[0] as LlmCall) ?? [];
-    const filePart = (parts as Array<Record<string, unknown>>).find(
-      (p) => p.mediaType === "application/pdf",
-    );
-    expect(filePart).toBeDefined();
-    expect((filePart as { filename: string }).filename).toBe("report.pdf");
+    const textPart = (parts as Array<Record<string, unknown>>)
+      .map((p) => (typeof p.text === "string" ? p.text : ""))
+      .join("\n");
+    expect(textPart).toContain("revenue grew 12 percent");
+    expect(
+      (parts as Array<Record<string, unknown>>).some((p) => p.type === "file"),
+    ).toBe(false);
   });
 });
 
