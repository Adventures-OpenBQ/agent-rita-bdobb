From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: artcashin <64659740+artcashin@users.noreply.github.com>
Date: Sat, 10 Oct 2026 01:00:04 -0400
Subject: [PATCH] fix(agent): retry an empty step, also after a client tool
 result

After a client tool result (describe_table), qwen3.6-35b sometimes ends its
reasoning with "now I'm building the arrange_table call" and stops: finish
reason stop, no text, no tool call. Nothing caught it. The 0011 retry needs
!isRebootToolTurn (false on every re-POST that carries a tool result) and a
<suggestions> block; terminalToolStop needs a tool that ran in this request,
and the client-executed tool is not one. The SSE was one status event, then
EOF, and the client got an empty reply (bdobb D-006, the rita-table-model-live
setup turn).

The first model call of a request (no tool ran in it yet) is now retried once
when its text is wholly empty, on a reboot tool turn too. The suggestions-only
case keeps its 0011 scope. A second empty reply passes through as before.

Measured with Qwen's captured empty completion injected on alternate steps
after describe_table: before, 5/10 replays empty and the live gate's setup
turn failed 2/3; after, 10/10 replays reached arrange_table (10 retries) and
the setup turn passed 3/3. Unforced, the empty stop is rare (1 of 153 steps
after describe_table).

Tests: four loop cases (retry after a client tool result, retry on a first
turn, a second empty reply passes through, no retry with answer text).
bun test tests/ 1018/1018; tsc --noEmit clean.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/agent/loop.ts                             | 15 ++--
 .../agent-loop/empty-step-retry.test.ts       | 90 +++++++++++++++++++
 2 files changed, 99 insertions(+), 6 deletions(-)
 create mode 100644 tests/integration/agent-loop/empty-step-retry.test.ts

diff --git a/src/agent/loop.ts b/src/agent/loop.ts
index 1e68ab0..6b3eb2f 100644
--- a/src/agent/loop.ts
+++ b/src/agent/loop.ts
@@ -1637,17 +1637,20 @@ export async function* runAgentLoop(options: AgentRunOptions): AsyncGenerator<SS
       const widgetCall = lastStep?.toolCalls.find((tc) => tc.toolName === "get_widget_data");
       if (!widgetCall) {
         // D-016: some models answer a first-turn tool request with only a
-        // <suggestions> block and stop. Retry that step once (loopIdx 0 only,
-        // so a second suggestions-only reply passes through as before).
+        // <suggestions> block and stop. D-006: after a client tool result,
+        // some stop with no text at all (the call was only in the reasoning).
+        // Retry either step once (loopIdx 0 only, so a second such reply
+        // passes through as before).
         const stepText = steps.map((step) => step.text).join("");
         if (
           loopIdx === 0 &&
-          !isRebootToolTurn &&
           completedToolNames.length === 0 &&
-          /<suggestions\b/i.test(stepText) &&
-          parseSuggestions(stepText).cleanText.trim() === ""
+          (stepText.trim() === "" ||
+            (!isRebootToolTurn &&
+              /<suggestions\b/i.test(stepText) &&
+              parseSuggestions(stepText).cleanText.trim() === ""))
         ) {
-          logger.warn("Model returned only a suggestions block before any tool call; retrying the step once", {
+          logger.warn("Model returned no answer text and no tool call; retrying the step once", {
             loopIdx,
             conversationId,
           });
diff --git a/tests/integration/agent-loop/empty-step-retry.test.ts b/tests/integration/agent-loop/empty-step-retry.test.ts
new file mode 100644
index 0000000..99ca010
--- /dev/null
+++ b/tests/integration/agent-loop/empty-step-retry.test.ts
@@ -0,0 +1,90 @@
+/**
+ * D-006: after a client tool result (describe_table), qwen3.6-35b sometimes
+ * finishes its reasoning ("now I'm building the arrange_table call") and stops
+ * with no text and no tool call. The request is a reboot tool turn and no tool
+ * ran in it, so terminalToolStop stayed quiet and the stream ended empty. The
+ * loop retries that empty step once, like a suggestions-only one (D-016); a
+ * second empty reply passes through, so there is no loop.
+ */
+
+import { describe, it, expect, beforeEach } from "bun:test";
+import { runAgentLoop, _resetWidgetDataCache } from "../../../src/agent/loop";
+import type { AgentTool, QueryRequest, SSEEvent, ToolMessage } from "../../../src/protocol/types";
+import { llmCallsTool, llmEmitsText, makeSequencedSpyMockLlm, type LlmStep } from "../../helpers/mock-llm";
+import { collectGenerator } from "../../helpers/sse-reader";
+import { clearAllModuleState } from "../../helpers/clear-state";
+
+beforeEach(() => {
+  clearAllModuleState();
+  _resetWidgetDataCache();
+});
+
+const empty: LlmStep = llmEmitsText("");
+const arrange = { card_id: "w", expected_revision: "tm1" };
+
+function tools(): AgentTool[] {
+  return ["describe_table", "arrange_table"].map((name) => ({
+    name,
+    server_id: "bdobb-local",
+    url: "",
+    description: name,
+    input_schema: { properties: { card_id: { type: "string" }, expected_revision: { type: "string" } }, required: ["card_id"] },
+  }));
+}
+
+/** The client's re-POST after it ran describe_table. */
+const described = {
+  role: "tool",
+  function: "execute_agent_tool",
+  input_arguments: { tool_name: "describe_table", server_id: "bdobb-local", parameters: { card_id: "w" } },
+  data: [{ items: [{ type: "text", text: JSON.stringify({ status: "ok", revision: "tm1" }) }] }],
+} as unknown as ToolMessage;
+
+async function run(messages: unknown[], steps: LlmStep[]) {
+  const spy = makeSequencedSpyMockLlm(steps);
+  const events = await collectGenerator(
+    runAgentLoop({
+      request: { messages, tools: tools() } as unknown as QueryRequest,
+      rawModelId: "openai:gpt-4o-mini",
+      model: spy.model,
+      allWidgets: [],
+      workspaceState: null,
+      generativeUiEnabled: false,
+      conversationId: "d006",
+    }),
+  );
+  return { calls: spy.calls.length, events };
+}
+
+function agentToolCalls(events: SSEEvent[]): string[] {
+  return events
+    .filter((e) => e.event === "copilotFunctionCall" && (e.data as { function?: string }).function === "execute_agent_tool")
+    .map((e) => (e.data as { input_arguments: { tool_name: string } }).input_arguments.tool_name);
+}
+
+const human = { role: "human", content: "Show total Amount by Region in the table." };
+
+describe("empty step retry (D-006)", () => {
+  it("retries an empty step right after a client tool result and emits the retry's call", async () => {
+    const { calls, events } = await run([human, described], [empty, llmCallsTool("arrange_table", arrange)]);
+    expect(calls).toBe(2);
+    expect(agentToolCalls(events)).toEqual(["arrange_table"]);
+  });
+
+  it("retries an empty first step of a turn too", async () => {
+    const { calls, events } = await run([human], [empty, llmCallsTool("describe_table", { card_id: "w" })]);
+    expect(calls).toBe(2);
+    expect(agentToolCalls(events)).toEqual(["describe_table"]);
+  });
+
+  it("passes a second empty reply through (no loop)", async () => {
+    const { calls, events } = await run([human, described], [empty, empty]);
+    expect(calls).toBe(2);
+    expect(agentToolCalls(events)).toEqual([]);
+  });
+
+  it("does not retry when there is answer text", async () => {
+    const { calls } = await run([human, described], [llmEmitsText("Region is text, so it cannot be summed.")]);
+    expect(calls).toBe(1);
+  });
+});
