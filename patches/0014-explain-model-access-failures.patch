+describe("model access failures", () => {
+  it.each([
+    [401, "check the provider credential"],
+    [402, "provider or gateway billing"],
+    [403, "model access"],
+    [429, "rate limit"],
+  ])("explains HTTP %i without exposing the provider response", async (statusCode, expected) => {
+    const error = Object.assign(new Error("opaque upstream failure sk-ant-private-test"), { statusCode });
+    const events = await run({ model: makeErroringStreamMockLlm(error) });
+    const answer = events.filter(e => e.event === "copilotMessageChunk")
+      .map(e => (e.data as { delta: string }).delta).join("");
+    expect(answer.toLowerCase()).toContain(expected);
+    expect(answer).not.toContain("sk-ant-private-test");
+    expect(events.some(e => e.event === "copilotStatusUpdate" &&
+      (e.data as { eventType?: string }).eventType === "ERROR")).toBe(true);
