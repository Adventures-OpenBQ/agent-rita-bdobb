new file mode 100644
index 0000000..3dbebc7
--- /dev/null
+++ b/tests/integration/aperture-provider.test.ts
@@ -0,0 +1,108 @@
+import { afterEach, describe, expect, it } from "bun:test";
+
+// Real provider/AI SDK boundary; a local server substitutes only external inference.
+// Each child has a fresh module registry, independent of other tests' mock.module calls.
+const servers: ReturnType<typeof Bun.serve>[] = [];
+afterEach(() => { for (const s of servers.splice(0)) s.stop(true); });
+function gateway(handler: (request: Request) => Response | Promise<Response>) {
+  const s = Bun.serve({ hostname: "127.0.0.1", port: 0, fetch: handler });
+  servers.push(s);
+  return `http://127.0.0.1:${s.port}`;
+}
+async function child(code: string, env: Record<string, string>) {
+  const p = Bun.spawn([process.execPath, "-e", code], {
+    cwd: process.cwd(), stdout: "pipe", stderr: "pipe",
+    env: { PATH: process.env.PATH, NODE_ENV: "test", OPENAI_API_KEY: "", OPENROUTER_API_KEY: "", GROQ_API_KEY: "", ANTHROPIC_API_KEY: "", ANTHROPIC_BASE_URL: "", DEFAULT_MODEL: "", ...env },
+  });
+  const [stdout, stderr, exit] = await Promise.all([new Response(p.stdout).text(), new Response(p.stderr).text(), p.exited]);
+  return { stdout, stderr, exit };
+}
+function textMessage(text: string) {
+  return Response.json({ id: "msg_audit", type: "message", role: "assistant", model: "claude-audit", content: [{ type: "text", text }], stop_reason: "end_turn", stop_sequence: null, usage: { input_tokens: 10, output_tokens: 2 } });
+}
+const helper = `import { singleShotLlm } from "./src/lib/llm.ts"; console.log("AUDIT_RESULT", await singleShotLlm("Reply pong"));`;
+
+describe("Anthropic through Aperture", () => {
+  for (const suffix of ["", "/", "/v1", "/v1/"]) {
+    it(`routes helper DEFAULT_MODEL to /v1/messages with base suffix '${suffix}'`, async () => {
+      const requests: { path: string; model: string; key: string | null }[] = [];
+      const url = gateway(async (req) => {
+        const body = await req.json() as { model: string };
+        requests.push({ path: new URL(req.url).pathname, model: body.model, key: req.headers.get("x-api-key") });
+        return textMessage("pong");
+      });
+      const out = await child(helper, { ANTHROPIC_BASE_URL: url + suffix, ANTHROPIC_API_KEY: "aperture-placeholder", DEFAULT_MODEL: "anthropic:claude-audit" });
+      expect(out.exit, out.stderr).toBe(0);
+      expect(out.stdout).toContain("AUDIT_RESULT pong");
+      expect(requests).toEqual([{ path: "/v1/messages", model: "claude-audit", key: "aperture-placeholder" }]);
+    });
+  }
+  it("supports a managed gateway without an upstream API key in Rita", async () => {
+    let model = "";
+    const url = gateway(async req => { model = (await req.json() as {model:string}).model; return textMessage("pong"); });
+    const out = await child(helper, { ANTHROPIC_BASE_URL: url, DEFAULT_MODEL: "anthropic:claude-audit" });
+    expect(out.exit, out.stderr).toBe(0);
+    expect(model).toBe("claude-audit");
+  });
+  it("honors an explicit helper model over DEFAULT_MODEL", async () => {
+    let model = "";
+    const url = gateway(async req => { model = (await req.json() as {model:string}).model; return textMessage("pong"); });
+    const out = await child(`import { singleShotLlm } from "./src/lib/llm.ts"; console.log(await singleShotLlm("pong", {model:"anthropic:claude-override"}));`, { ANTHROPIC_BASE_URL: url, DEFAULT_MODEL: "anthropic:claude-audit" });
+    expect(out.exit, out.stderr).toBe(0);
+    expect(model).toBe("claude-override");
+  });
+  it("rejects an unavailable explicit provider instead of sending it to OpenAI", async () => {
+    let calls = 0;
+    const url = gateway(() => { calls++; return textMessage("wrong provider"); });
+    const out = await child(`import { resolveModel } from "./src/lib/providers.ts"; try { resolveModel("anthropic:claude-audit"); process.exitCode=9; } catch(e) { console.log(String(e)); }`, { OPENAI_API_KEY: "test-openai", OPENAI_BASE_URL: url });
+    expect(out.exit, out.stderr).toBe(0);
+    expect(out.stdout).toContain("No provider available for model: anthropic:claude-audit");
+    expect(calls).toBe(0);
+  });
+  it("advertises the configured Claude model to BDOBB", async () => {
+    const out = await child(`import { agentsRouter } from "./src/routes/agents.ts"; const r=await agentsRouter.request("/agents.json"); const a=(await r.json()).openbb_agent_rita.features.model; console.log("AUDIT_RESULT", JSON.stringify(a));`, { ANTHROPIC_BASE_URL: "http://127.0.0.1:1", DEFAULT_MODEL: "anthropic:claude-audit" });
+    expect(out.exit, out.stderr).toBe(0);
+    const line=out.stdout.split("\n").find(x=>x.startsWith("AUDIT_RESULT "))!;
+    const picker=JSON.parse(line.slice(13));
+    expect(picker.default).toBe("anthropic:claude-audit");
+    expect(picker.options.some((x:{value:string})=>x.value==="anthropic:claude-audit")).toBe(true);
+  });
+  it("propagates rejected gateway credentials", async () => {
+    const url=gateway(()=>Response.json({type:"error",error:{type:"authentication_error",message:"audit denied"}},{status:401}));
+    const out=await child(helper,{ANTHROPIC_BASE_URL:url,DEFAULT_MODEL:"anthropic:claude-audit"});
+    expect(out.exit).not.toBe(0);
+    expect(out.stderr).toContain("audit denied");
+  });
+  it("preserves the historical OpenAI helper default when no model is configured",async()=>{
+    let model="";
+    const url=gateway(async req=>{model=(await req.json() as {model:string}).model; return Response.json({id:"chat_audit",object:"chat.completion",created:1,model,choices:[{index:0,message:{role:"assistant",content:"pong"},finish_reason:"stop"}],usage:{prompt_tokens:1,completion_tokens:1,total_tokens:2}});});
+    const out=await child(helper,{OPENAI_API_KEY:"test-openai",OPENAI_BASE_URL:url});
+    expect(out.exit,out.stderr).toBe(0);
+    expect(out.stdout).toContain("AUDIT_RESULT pong");
+    expect(model).toBe("gpt-4o-mini");
+  });
+  it("streams text after a complete Claude tool-result round trip", async () => {
+    const requests: Record<string,unknown>[]=[];
+    const url=gateway(async req=>{
+      expect(new URL(req.url).pathname).toBe("/v1/messages");
+      const body=await req.json() as Record<string,unknown>; requests.push(body);
+      const tool=requests.length===1;
+      const events=[
+        ["message_start",{type:"message_start",message:{id:`msg_${requests.length}`,type:"message",role:"assistant",model:"claude-audit",content:[],stop_reason:null,stop_sequence:null,usage:{input_tokens:10,output_tokens:0}}}],
