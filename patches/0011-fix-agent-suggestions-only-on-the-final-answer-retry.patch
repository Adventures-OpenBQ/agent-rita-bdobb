diff --git a/tests/integration/agent-loop/suggestions-only-retry.test.ts b/tests/integration/agent-loop/suggestions-only-retry.test.ts
new file mode 100644
index 0000000..24848fc
--- /dev/null
+++ b/tests/integration/agent-loop/suggestions-only-retry.test.ts
@@ -0,0 +1,85 @@
+/**
+ * D-016: on a first-turn tool request, qwen3.6-35b sometimes reasons "let me
+ * search for the widget" and then emits only a <suggestions> block and stops,
+ * with no tool call. The loop retries that step once — only when nothing but
+ * whitespace + a suggestions block came back, no tool ran this turn, and it is
+ * the first model call of the request. A second suggestions-only reply passes
+ * through unchanged, so there is no loop.
+ */
+
+import { describe, it, expect, beforeEach } from "bun:test";
+import { runAgentLoop } from "../../../src/agent/loop";
+import type { QueryRequest, SSEEvent } from "../../../src/protocol/types";
+import { llmCallsTool, llmEmitsText, makeSequencedSpyMockLlm, type LlmStep } from "../../helpers/mock-llm";
+import { collectGenerator } from "../../helpers/sse-reader";
+import { clearAllModuleState } from "../../helpers/clear-state";
+
+beforeEach(() => clearAllModuleState());
+
+const suggestionsOnly = (s: string): LlmStep =>
+  llmEmitsText(`\n\n<suggestions>\n<suggestion>${s}</suggestion>\n</suggestions>`);
+
+async function run(steps: LlmStep[]) {
+  const spy = makeSequencedSpyMockLlm(steps);
+  const events = await collectGenerator(
+    runAgentLoop({
+      request: { messages: [{ role: "human", content: "add an AAPL chart" }] } as QueryRequest,
+      rawModelId: "openai:gpt-4o-mini",
+      model: spy.model,
+      allWidgets: [],
+      workspaceState: null,
+      generativeUiEnabled: false,
+      promptSuggestionsEnabled: true,
+      conversationId: "d016",
+    }),
+  );
+  return { calls: spy.calls.length, events };
+}
+
+function text(events: SSEEvent[]): string {
+  return events
+    .filter((e) => e.event === "copilotMessageChunk")
+    .map((e) => (e.data as { delta: string }).delta)
+    .join("");
+}
+
+function suggestions(events: SSEEvent[]): string[][] {
+  return events
+    .filter((e) => e.event === "copilotPromptSuggestions")
+    .map((e) => (e.data as { suggestions: string[] }).suggestions);
+}
+
+describe("suggestions-only step retry (D-016)", () => {
+  it("retries a suggestions-only first step once and keeps the retry's answer", async () => {
+    const { calls, events } = await run([
+      suggestionsOnly("Stale"),
+      llmEmitsText("Done.\n\n<suggestions>\n<suggestion>Fresh</suggestion>\n</suggestions>"),
+    ]);
+    expect(calls).toBe(2);
+    expect(text(events)).toContain("Done.");
+    expect(suggestions(events)).toEqual([["Fresh"]]);
+  });
+
+  it("passes a second suggestions-only reply through as today (no loop)", async () => {
+    const { calls, events } = await run([suggestionsOnly("First"), suggestionsOnly("Second")]);
+    expect(calls).toBe(2);
+    expect(suggestions(events)).toEqual([["Second"]]);
+  });
+
+  it("does not retry when there is real answer text", async () => {
+    const { calls, events } = await run([
+      llmEmitsText("Here you go.\n\n<suggestions>\n<suggestion>Next</suggestion>\n</suggestions>"),
+    ]);
+    expect(calls).toBe(1);
+    expect(suggestions(events)).toEqual([["Next"]]);
+  });
+
+  it("does not retry after a tool already ran this turn", async () => {
+    const { calls, events } = await run([
+      llmCallsTool("search_widgets", { query: "aapl" }),
+      suggestionsOnly("After tool"),
+    ]);
+    expect(calls).toBe(2);
+    expect(suggestions(events)).toEqual([["After tool"]]);
+  });
+});
diff --git a/tests/unit/src/agent/prompt.test.ts b/tests/unit/src/agent/prompt.test.ts
index 4654eed..d320181 100644
--- a/tests/unit/src/agent/prompt.test.ts
+++ b/tests/unit/src/agent/prompt.test.ts
@@ -373,6 +373,48 @@ describe("buildSystemPrompt — generative UI options", () => {
   });
 });
 
+// Regression (D-016): "End every response with … Always include the suggestions
+// block", placed last in the prompt, made qwen3.6-35b answer a first-turn tool
+// request with only a <suggestions> block and no tool call (8/10 empty). The
+// section now says suggestions belong to the final answer only, and sits before
+// the data-source listing instead of at the end.
+describe("buildSystemPrompt — follow-up suggestions", () => {
+  it("omits the section when suggestions are off", () => {
+    expect(buildSystemPrompt(req())).not.toContain("FOLLOW-UP SUGGESTIONS");
+  });
+
+  it("inline: suggestions are final-answer text and never replace a tool call", () => {
+    const out = buildSystemPrompt(req(), { promptSuggestionsEnabled: true });
+    expect(out).toContain("FOLLOW-UP SUGGESTIONS (final answer only):");
+    expect(out).toContain(
+      "Follow-up suggestions are answer text, so the RESPONSE STRUCTURE rule applies: write them only after the final " +
+        "tool result. When the request needs a tool, respond with the tool call and nothing else.",
+    );
+    expect(out).toContain("When you write your final answer for this turn, end it with 2-3 short follow-up questions");
+    expect(out).toContain("<suggestions>\n<suggestion>Check the Insider Trading widget for executive holdings</suggestion>");
+    expect(out).toContain("Include the block in every final answer, even short ones.");
+    expect(out).toContain("widgets and data sources listed below");
+    expect(out).not.toContain("End every response");
+    expect(out).not.toContain("Always include the suggestions block");
+  });
+
+  it("places the section before the data-source listing, not at the end", () => {
+    const out = buildSystemPrompt(req(), { promptSuggestionsEnabled: true });
+    const section = out.indexOf("FOLLOW-UP SUGGESTIONS");
+    expect(section).toBeGreaterThan(out.indexOf("PYTHON CODE EXECUTION"));
+    expect(section).toBeLessThan(out.indexOf("No widgets or data sources are currently available"));
+  });
+
+  it("tool spike: suggest_followups only in the final answer, never instead of another tool", () => {
+    const out = buildSystemPrompt(req(), { promptSuggestionsEnabled: true, suggestionsVia: "tool" });
+    expect(out).toContain("FOLLOW-UP SUGGESTIONS (final answer only):");
+    expect(out).toContain("When the request needs another tool, call that tool, not suggest_followups.");
+    expect(out).toContain("call the suggest_followups tool with 2-3 short follow-up questions");
+    expect(out).not.toContain("At the end of every response");
+    expect(out).not.toContain("<suggestions>");
+  });
+});
+
 // Regression guard: the system prompt must advertise exactly the MCP tools the
 // factory registered. Listing raw request.tools leaks bridge-command wrappers
 // the filter dropped, and the model calls ghosts (18x agentritamcp_update_widget,
