+/** Correlate a completed call with its output without carrying internal state. */
+export function toolInputReceipt(toolMsg: ToolMessage): string {
+  const args = toolMsg.input_arguments;
+  const server = typeof args?.server_id === "string" ? args.server_id.slice(0, 200) : "unknown";
+  let input = JSON.stringify(args?.parameters ?? {});
+  if (input.length > 4096) input = input.slice(0, 4096) + "… [input truncated]";
+  return `Executed on server ${server} with parameters: ${input}`;
+}
