diff --git a/tests/integration/agent-loop/agent-tool-queue.test.ts b/tests/integration/agent-loop/agent-tool-queue.test.ts
new file mode 100644
index 0000000..e6d303d
--- /dev/null
+++ b/tests/integration/agent-loop/agent-tool-queue.test.ts
@@ -0,0 +1,143 @@
+/**
+ * Tier 2 — several MCP / client-tool calls in one model step (bdobb-v2 #326).
+ *
+ * The client executes exactly one copilotFunctionCall per re-POST. The first
+ * execute_agent_tool is emitted; the rest ride extra_state as
+ * pending_agent_tool_calls and drain one per re-POST before the model runs
+ * again — none silently dropped, each emitted once, in the model's order.
+ */
+
+import { describe, it, expect, beforeEach } from "bun:test";
+import { runAgentLoop, _resetWidgetDataCache } from "../../../src/agent/loop";
+import type { AgentTool, QueryRequest, SSEEvent, ToolMessage } from "../../../src/protocol/types";
+import { llmEmitsText, makeMockLlm } from "../../helpers/mock-llm";
+import { collectGenerator } from "../../helpers/sse-reader";
+import { clearAllModuleState } from "../../helpers/clear-state";
+
+beforeEach(() => {
+  clearAllModuleState();
+  _resetWidgetDataCache();
+});
+
+function tools(): AgentTool[] {
+  return [
+    {
+      name: "set_markdown_content",
+      server_id: "bdobb-local",
+      url: "",
+      description: "Replace a note card's body",
+      input_schema: {
+        properties: { card_id: { type: "string" }, text: { type: "string" } },
+        required: ["card_id", "text"],
+      },
+    },
+  ];
+}
+
+function agentToolCalls(events: SSEEvent[]) {
+  return events
+    .filter((e) => e.event === "copilotFunctionCall" && (e.data as { function?: string }).function === "execute_agent_tool")
+    .map((e) => e.data as {
+      input_arguments: { tool_name: string; server_id: string; parameters: Record<string, unknown> };
+      extra_state?: { pending_agent_tool_calls?: Array<{ tool_name: string; input: Record<string, unknown> }> };
+    });
+}
+
+const save = (card: string) => ({ card_id: card, text: `answer ${card}` });
+
+/** The client's re-POST of one executed call, echoing the extra_state it was given. */
+function result(card: string, extra_state?: Record<string, unknown>): ToolMessage {
+  return {
+    role: "tool",
+    function: "execute_agent_tool",
+    input_arguments: { tool_name: "set_markdown_content", server_id: "bdobb-local", parameters: save(card) },
+    data: [{ items: [{ type: "text", text: JSON.stringify({ updated: true, card_id: card }) }] }],
+    ...(extra_state ? { extra_state } : {}),
+  } as unknown as ToolMessage;
+}
+
+function run(messages: unknown[], model = makeMockLlm(llmEmitsText("MODEL SHOULD NOT RUN"))) {
+  return collectGenerator(
+    runAgentLoop({
+      request: { messages, tools: tools() } as unknown as QueryRequest,
+      rawModelId: "openai:gpt-4o-mini",
+      model,
+      allWidgets: [],
+      workspaceState: null,
+      generativeUiEnabled: false,
+      conversationId: "queue-1",
+    }),
+  );
+}
+
+describe("execute_agent_tool — several calls in one step", () => {
+  it("emits the first call and queues the rest, in order", async () => {
+    const events = await run(
+      [{ role: "human", content: "write all three" }],
+      makeMockLlm({
+        toolCalls: [
+          { toolName: "set_markdown_content", input: save("a") },
+          { toolName: "set_markdown_content", input: save("b") },
+          { toolName: "set_markdown_content", input: save("c") },
+        ],
+        finishReason: "tool-calls",
+      }),
+    );
+    const calls = agentToolCalls(events);
+    expect(calls).toHaveLength(1);
+    expect(calls[0]!.input_arguments.parameters).toEqual(save("a"));
+    expect(calls[0]!.extra_state?.pending_agent_tool_calls).toEqual([
+      { tool_name: "set_markdown_content", input: save("b") },
+      { tool_name: "set_markdown_content", input: save("c") },
+    ]);
+  });
+
+  it("drains one queued call per re-POST before the model runs, then the model answers", async () => {
+    const queue = [
+      { tool_name: "set_markdown_content", input: save("b") },
+      { tool_name: "set_markdown_content", input: save("c") },
+    ];
+    const human = { role: "human", content: "write all three" };
+
+    const second = await run([human, result("a", { pending_agent_tool_calls: queue })]);
+    const c2 = agentToolCalls(second);
+    expect(c2).toHaveLength(1);
+    expect(c2[0]!.input_arguments.parameters).toEqual(save("b"));
+    expect(c2[0]!.extra_state?.pending_agent_tool_calls).toEqual([queue[1]]);
+    expect(second.some((e) => e.event === "copilotMessageChunk")).toBe(false);
+
+    const third = await run([human, result("a"), result("b", { pending_agent_tool_calls: [queue[1]] })]);
+    const c3 = agentToolCalls(third);
+    expect(c3).toHaveLength(1);
+    expect(c3[0]!.input_arguments.parameters).toEqual(save("c"));
+    expect(c3[0]!.extra_state?.pending_agent_tool_calls).toBeUndefined();
+
+    // Queue empty: the next re-POST runs the model with every result in hand.
+    const last = await run([human, result("a"), result("b"), result("c")], makeMockLlm(llmEmitsText("All three saved.")));
+    expect(agentToolCalls(last)).toHaveLength(0);
+    expect(last.some((e) => e.event === "copilotMessageChunk")).toBe(true);
+  });
+
+  it("ignores a malformed echoed queue: not a list, or an entry whose input is not an object", async () => {
+    for (const bad of ["oops", [{ tool_name: "set_markdown_content", input: "x" }]]) {
+      const events = await run(
+        [{ role: "human", content: "go" }, result("a", { pending_agent_tool_calls: bad })],
+        makeMockLlm(llmEmitsText("done")),
+      );
+      expect(agentToolCalls(events)).toHaveLength(0);
+      expect(events.some((e) => e.event === "copilotMessageChunk")).toBe(true);
+    }
+  });
+
+  it("drops a queued call whose tool is not offered this turn (the queue is client-echoed)", async () => {
+    const events = await run(
+      [
+        { role: "human", content: "go" },
+        result("a", { pending_agent_tool_calls: [{ tool_name: "delete_everything", input: {} }] }),
+      ],
+      makeMockLlm(llmEmitsText("done")),
+    );
+    expect(agentToolCalls(events)).toHaveLength(0);
+    expect(events.some((e) => e.event === "copilotMessageChunk")).toBe(true);
+  });
+});
