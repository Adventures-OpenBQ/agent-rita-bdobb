+    if (isRebootToolTurn && mcpEntryBySanitized) {
+      const echoed = rebootExtra.pending_agent_tool_calls;
+      const queued = (Array.isArray(echoed) ? echoed : []).filter((c) => {
+        const ok =
+          typeof c?.tool_name === "string" &&
