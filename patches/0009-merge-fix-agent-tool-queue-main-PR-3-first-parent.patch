     input_arguments: Record<string, unknown>;
   }>;
+  /**
+   * MCP / client-tool calls (execute_agent_tool) the model issued in one step
+   * beyond the first. Same one-per-re-POST drain as pending_bridge_calls:
+   * the first is emitted, the rest queue here and are emitted one per re-POST
+   * before the model runs again. Without it every call after the first was
+   * dropped, and the model re-issued some of them later (bdobb-v2 #326: three
+   * set_markdown_content calls, one executed, one card written four times).
+   * `tool_name` is the sanitized (model-facing) name.
+   */
+  pending_agent_tool_calls?: Array<{
+    tool_name: string;
+    input: Record<string, unknown>;
