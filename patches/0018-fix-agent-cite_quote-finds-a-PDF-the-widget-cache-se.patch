+/**
+ * 0018: cite_quote after a widget-cache hit must use the PDF cached under the
+ * SAME {uuid, args} key the cache hit served, not another entry for that uuid.
+ */
+import { describe, it, expect, beforeEach } from "bun:test";
+import { cacheWidgetItemsFromReboot, runAgentLoop } from "../../../src/agent/loop";
+import type { Citation } from "../../../src/protocol/citations";
+import type { QueryRequest, ToolMessage, Widget } from "../../../src/protocol/types";
+import { llmCallsTool, llmEmitsText, makeSequencedSpyMockLlm } from "../../helpers/mock-llm";
+import { collectGenerator } from "../../helpers/sse-reader";
+import { clearAllModuleState } from "../../helpers/clear-state";
+
+function pdfBase64(lines: string[]): string {
+  const esc = (s: string) => s.replace(/[\\()]/g, (c) => `\\${c}`);
+  const stream = `BT /F1 12 Tf 72 720 Td 16 TL ${lines.map((l) => `(${esc(l)}) '`).join(" ")} ET`;
+  const objects = [
+    "<< /Type /Catalog /Pages 2 0 R >>",
+    "<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+    "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>",
+    `<< /Length ${stream.length} >>\nstream\n${stream}\nendstream`,
+    "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
+  ];
+  let out = "%PDF-1.4\n";
+  const offsets = objects.map((body, i) => {
+    const at = out.length;
+    out += `${i + 1} 0 obj\n${body}\nendobj\n`;
+    return at;
+  });
+  const xref = out.length;
+  out += `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n${offsets.map((o) => `${String(o).padStart(10, "0")} 00000 n \n`).join("")}`;
+  out += `trailer\n<< /Size ${objects.length + 1} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF\n`;
+  return btoa(out);
+}
+
+const UUID = "w-pdf";
+const report: Widget = {
+  uuid: UUID, origin: "b", widget_id: "report", name: "Report", description: "",
+  params: [{ name: "year", type: "text", description: "", current_value: "" }],
+} as unknown as Widget;
+const toolFor = (year: string, line: string): ToolMessage =>
+  ({
+    role: "tool",
+    function: "get_widget_data",
+    input_arguments: { data_sources: [{ widget_uuid: UUID, input_args: { year } }] },
+    data: [{ items: [{ content: pdfBase64([line]), data_format: { data_type: "pdf", filename: `${year}.pdf` } }] }],
+  }) as unknown as ToolMessage;
+
+describe("cite_quote through the loop after a cache hit", () => {
+  beforeEach(() => clearAllModuleState());
+
+  it("highlights from the PDF of the args the cache served, not the newest entry for the uuid", async () => {
+    await cacheWidgetItemsFromReboot(toolFor("2024", "Alpha revenue grew 12 percent."), [report]);
+    await cacheWidgetItemsFromReboot(toolFor("2025", "Beta revenue fell 3 percent."), [report]);
+    const spy = makeSequencedSpyMockLlm([
+      llmCallsTool("get_widget_data", { widgets: [{ widget_uuid: UUID, input_args: { year: "2024" } }] }),
+      llmCallsTool("cite_quote", { widget_uuid: UUID, quote: "Alpha revenue grew 12 percent" }),
+      llmEmitsText("Revenue grew 12 percent."),
+    ]);
+    const events = await collectGenerator(
+      runAgentLoop({
+        request: { messages: [{ role: "human", content: "2024 revenue?" }] } as QueryRequest,
+        rawModelId: "openai:gpt-4o-mini",
+        model: spy.model,
+        allWidgets: [report],
+        workspaceState: null,
+        generativeUiEnabled: false,
+        conversationId: "cq-cache-exact",
+      }),
+    );
+    const collection = events.find((e) => e.event === "copilotCitationCollection");
+    const cites = (collection?.data as { citations: Citation[] } | undefined)?.citations ?? [];
+    const boxes = cites.flatMap((c) => (c as unknown as { quote_bounding_boxes?: unknown[][] }).quote_bounding_boxes ?? []);
+    expect(boxes).toHaveLength(1);
+  });
+});
