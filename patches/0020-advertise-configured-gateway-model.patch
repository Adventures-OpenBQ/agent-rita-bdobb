 export function allModels(): ModelEntry[] {
-  return providers.flatMap((p) => p.models);
+  const models = providers.flatMap((p) => p.models);
+  const configured = process.env.DEFAULT_MODEL;
+  // Gateways can expose model IDs beyond the built-in suggestions. Keep the
+  // configured default selectable without advertising an unavailable provider.
+  const provider = configured && providers.find((p) => configured.startsWith(`${p.prefix}:`));
+  if (configured && provider && configured.slice(provider.prefix.length + 1).trim() && !models.some((m) => m.id === configured)) {
+    models.unshift({ id: configured, name: configured });
+  }
+  return models;
 }
 
