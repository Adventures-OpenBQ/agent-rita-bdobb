# Optional v6 Rita experiment through your own Aperture gateway.
# Copy outside every repository and chmod 600 the private copy.
# The Rita container must be able to resolve and reach this tailnet URL.
OPENAI_BASE_URL=https://aperture.<your-tailnet>.ts.net/v1
# Non-secret SDK placeholder for managed Aperture routes only.
# Credential-passthrough routes require the real provider credential instead.
OPENAI_API_KEY=tailscale-aperture
# Example tested in v6. Verify this exact model ID exists in your gateway.
# The openai: prefix selects Chat Completions, not the model vendor.
DEFAULT_MODEL=openai:deepseek/deepseek-v4.1-flash
PORT=7777
COMPANION_TOOLS_ENABLED=false
# Hosted inference may consume gateway/provider balance; it is not guaranteed free.
# Shared dashboard context and tool results can be sent to the hosted provider.
