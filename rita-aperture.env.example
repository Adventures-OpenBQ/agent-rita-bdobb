# Private Rita audit instance. Copy outside every repository, chmod 600.
# Use the actual gateway URL from Aperture setup; /v1 is normalized by Rita.
ANTHROPIC_BASE_URL=
# Managed gateway: leave blank; Rita sends a non-secret placeholder and Aperture
# authenticates your tailnet identity and injects its upstream credential.
# Passthrough gateway: supply the provider API key privately instead.
ANTHROPIC_API_KEY=
# Use an exact Claude model enabled on your Aperture gateway, with this prefix.
# Example only; verify the gateway grants this model before sending inference.
DEFAULT_MODEL=anthropic:claude-sonnet-4-6
PORT=7777
COMPANION_TOOLS_ENABLED=false
